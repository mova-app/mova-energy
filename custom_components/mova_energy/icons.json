{
  "entity": {
    "sensor": {
      "run_status": {
        "default": "mdi:state-machine"
      },
      "firmware_version": {
        "default": "mdi:chip"
      },
      "filter_life": {
        "default": "mdi:air-filter"
      }
    },
    "switch": {
      "child_lock": {
        "default": "mdi:lock",
        "state": {
          "off": "mdi:lock-open-variant"
        }
      },
      "led_display": {
        "default": "mdi:led-on",
        "state": {
          "off": "mdi:led-off"
        }
      }
    },
    "select": {
      "work_mode": {
        "default": "mdi:state-machine"
      },
      "fan_speed": {
        "default": "mdi:fan",
        "state": {
          "low": "mdi:fan-speed-1",
          "medium": "mdi:fan-speed-2",
          "high": "mdi:fan-speed-3",
          "auto": "mdi:fan-auto"
        }
      }
    },
    "number": {
      "soc_upper": {
        "default": "mdi:battery-arrow-up"
      },
      "soc_lower": {
        "default": "mdi:battery-arrow-down"
      },
      "backup_soc": {
        "default": "mdi:battery-lock"
      }
    }
  },
  "services": {
    "refresh_data": {
      "service": "mdi:refresh"
    }
  }
}
